{
  "effects": [
    {
      "name": "Elevation/XS",
      "description": "var(--ns-elevation-xs)",
      "effects": [
        {"type": "DROP_SHADOW", "color": "@Primitives/alpha/black-6", "x": 0, "y": 1, "blur": 2, "spread": 0},
        {"type": "DROP_SHADOW", "color": "@Primitives/alpha/black-10", "x": 0, "y": 1, "blur": 3, "spread": 0}
      ]
    },
    {
      "name": "Elevation/SM",
      "description": "var(--ns-elevation-sm)",
      "effects": [
        {"type": "DROP_SHADOW", "color": "@Primitives/alpha/black-6", "x": 0, "y": 2, "blur": 4, "spread": -1},
        {"type": "DROP_SHADOW", "color": "@Primitives/alpha/black-10", "x": 0, "y": 4, "blur": 6, "spread": -1}
      ]
    },
    {
      "name": "Elevation/MD",
      "description": "var(--ns-elevation-md)",
      "effects": [
        {"type": "DROP_SHADOW", "color": "@Primitives/alpha/black-5", "x": 0, "y": 4, "blur": 6, "spread": -2},
        {"type": "DROP_SHADOW", "color": "@Primitives/alpha/black-10", "x": 0, "y": 10, "blur": 15, "spread": -3}
      ]
    },
    {
      "name": "Elevation/LG",
      "description": "var(--ns-elevation-lg)",
      "effects": [
        {"type": "DROP_SHADOW", "color": "@Primitives/alpha/black-5", "x": 0, "y": 4, "blur": 8, "spread": -2},
        {"type": "DROP_SHADOW", "color": "@Primitives/alpha/black-14", "x": 0, "y": 15, "blur": 40, "spread": -4}
      ]
    },
    {
      "name": "Elevation/XL",
      "description": "var(--ns-elevation-xl)",
      "effects": [
        {"type": "DROP_SHADOW", "color": "@Primitives/alpha/black-5", "x": 0, "y": 4, "blur": 8, "spread": -2},
        {"type": "DROP_SHADOW", "color": "@Primitives/alpha/black-18", "x": 0, "y": 16, "blur": 72, "spread": -4}
      ]
    },
    {
      "name": "Glass/SM",
      "description": "Background blur 6 (blur/sm). Pair with bg/glass fill.",
      "effects": [
        {"type": "BACKGROUND_BLUR", "radius": "@Effects/blur/sm"}
      ]
    },
    {
      "name": "Glass/LG",
      "description": "Background blur 24 (blur/lg). Pair with bg/glass fill.",
      "effects": [
        {"type": "BACKGROUND_BLUR", "radius": "@Effects/blur/lg"}
      ]
    },
    {
      "name": "Glow/XL",
      "description": "Layer blur 240 (blur/glow) for background light blobs.",
      "effects": [
        {"type": "LAYER_BLUR", "radius": "@Effects/blur/glow"}
      ]
    },
    {
      "name": "Inset/Hairline",
      "description": "Inner shadow 0 0 1, black 10%.",
      "effects": [
        {"type": "INNER_SHADOW", "color": "@Primitives/alpha/black-10", "x": 0, "y": 0, "blur": 1, "spread": 0}
      ]
    }
  ],
  "gradients": [
    {
      "name": "Gradient/Blue Light to Dark",
      "description": "",
      "type": "GRADIENT_LINEAR",
      "transform": [[1, 0, 0], [0, 1, 0]],
      "stops": [
        {"position": 0, "color": "#d6f1ff"},
        {"position": 0.3, "color": "#00a3f5"},
        {"position": 0.5, "color": "#0088cc"},
        {"position": 0.75, "color": "#003552"},
        {"position": 1, "color": "#001b29"}
      ]
    },
    {
      "name": "Gradient/Red Light to Dark",
      "description": "",
      "type": "GRADIENT_LINEAR",
      "transform": [[1, 0, 0], [0, 1, 0]],
      "stops": [
        {"position": 0, "color": "#fee3e4"},
        {"position": 0.1, "color": "#ffb2b2"},
        {"position": 0.3, "color": "#f4666e"},
        {"position": 0.6, "color": "#ef1a25"},
        {"position": 1, "color": "#ac0c14"}
      ]
    },
    {
      "name": "Gradient/Blue Base to Dark",
      "description": "",
      "type": "GRADIENT_LINEAR",
      "transform": [[1, 0, 0], [0, 1, 0]],
      "stops": [
        {"position": 0, "color": "#004367"},
        {"position": 0.4, "color": "#003552"},
        {"position": 1, "color": "#001b29"}
      ]
    },
    {
      "name": "Gradient/Red Base to Dark",
      "description": "",
      "type": "GRADIENT_LINEAR",
      "transform": [[1, 0, 0], [0, 1, 0]],
      "stops": [
        {"position": 0, "color": "#ef1a25"},
        {"position": 0.5, "color": "#ac0c14"},
        {"position": 1, "color": "#86090f"}
      ]
    },
    {
      "name": "Gradient/Night Fade",
      "description": "Website image fade: #000000 → night/900 (#181728), top to bottom.",
      "type": "GRADIENT_LINEAR",
      "transform": [[0, 1, 0], [-1, 0, 1]],
      "stops": [
        {"position": 0, "color": "#000000"},
        {"position": 1, "color": "#181728"}
      ]
    }
  ]
}
