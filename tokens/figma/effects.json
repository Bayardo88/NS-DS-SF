{
  "effects": [
    {
      "name": "Elevation/XS",
      "description": "var(--ns-elevation-xs)",
      "effects": [
        {"type": "DROP_SHADOW", "color": "@Primitives/alpha/black-6", "x": 0, "y": 1, "blur": 2, "spread": 0},
