        {"type": "DROP_SHADOW", "color": "@Primitives/alpha/black-5", "x": 0, "y": 4, "blur": 8, "spread": -2},
        {"type": "DROP_SHADOW", "color": "@Primitives/alpha/black-18", "x": 0, "y": 16, "blur": 72, "spread": -4}
      ]
    },
    {
      "name": "Glass/SM",
      "description": "Background blur 6 (blur/sm). Pair with bg/glass fill.",
      "effects": [
        {"type": "BACKGROUND_BLUR", "radius": "@Effects/blur/sm"}
      ]
    },
    {
      "name": "Glass/LG",
      "description": "Background blur 24 (blur/lg). Pair with bg/glass fill.",
      "effects": [
        {"type": "BACKGROUND_BLUR", "radius": "@Effects/blur/lg"}
      ]
    },
    {
      "name": "Glow/XL",
      "description": "Layer blur 240 (blur/glow) for background light blobs.",
      "effects": [
        {"type": "LAYER_BLUR", "radius": "@Effects/blur/glow"}
      ]
    },
    {
      "name": "Inset/Hairline",
      "description": "Inner shadow 0 0 1, black 10%.",
      "effects": [
        {"type": "INNER_SHADOW", "color": "@Primitives/alpha/black-10", "x": 0, "y": 0, "blur": 1, "spread": 0}
      ]
    },
    {
      "name": "Glass/XL",
      "description": "Web 2023 glass card: background blur 40 + soft shadow 0 8 24.",
      "effects": [
        {"type": "BACKGROUND_BLUR", "radius": "@Effects/blur/xl"},
        {"type": "DROP_SHADOW", "color": "@Primitives/alpha/black-8", "x": 0, "y": 8, "blur": 24, "spread": 0}
      ]
    },
    {
      "name": "Glow/LG",
      "description": "Layer blur 80 for background light blobs (Web 2023).",
      "effects": [
        {"type": "LAYER_BLUR", "radius": "@Effects/blur/2xl"}
      ]
    },
    {
      "name": "Shadow/Hard",
      "description": "Hard offset shadow 3 3 0 (Careers retro style).",
      "effects": [
        {"type": "DROP_SHADOW", "color": "@Primitives/alpha/black-30", "x": 3, "y": 3, "blur": 0, "spread": 0}
      ]
    },
    {
      "name": "Shadow/Wine",
      "description": "Wine-tinted glow 0 30 30 (Careers).",
      "effects": [
        {"type": "DROP_SHADOW", "color": "@Primitives/alpha/wine-50", "x": 0, "y": 30, "blur": 30, "spread": 0}
      ]
    },
    {
      "name": "Shadow/Float",
      "description": "Navy-tinted float shadow 0 16 32 (Web 2023).",
      "effects": [
        {"type": "DROP_SHADOW", "color": "@Primitives/alpha/navy-16", "x": 0, "y": 16, "blur": 32, "spread": 0}
      ]
    }
  ],
